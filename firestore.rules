rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /smsTemp/{messageId} { allow read, write: if true; }
    match /configuracionPublica/{configId} {
      allow read: if configId == 'equipos';
      allow create, update: if configId == 'equipos'
        && request.resource.data.keys().hasOnly(['soporte', 'ventas', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['soporte', 'ventas', 'actualizadoEn'])
        && request.resource.data.soporte is map
        && request.resource.data.ventas is map
        && request.resource.data.soporte.keys().hasOnly(['arriba', 'abajo', 'sanJuan', 'riohacha'])
        && request.resource.data.soporte.keys().hasAll(['arriba', 'abajo', 'sanJuan', 'riohacha'])
        && request.resource.data.ventas.keys().hasOnly(['valledupar', 'pueblos'])
        && request.resource.data.ventas.keys().hasAll(['valledupar', 'pueblos'])
        && request.resource.data.soporte.arriba is list
        && request.resource.data.soporte.abajo is list
        && request.resource.data.soporte.sanJuan is list
        && request.resource.data.soporte.riohacha is list
        && request.resource.data.ventas.valledupar is list
        && request.resource.data.ventas.pueblos is list;
      allow delete: if false;
    }
    match /cajasVerificadas/{boxId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.asesorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['fecha', 'tipoCaja', 'numeroCaja', 'direccion', 'tecnico', 'asesor', 'link', 'cedulas', 'asesorUid', 'creadoPor', 'usuarioRegistrado', 'creadoEn']);
      allow update, delete: if false;
    }
    match /asesores/{advisorUid} {
      allow create: if signedIn() && request.auth.uid == advisorUid
        && request.resource.data.uid == advisorUid
        && request.resource.data.keys().hasOnly(['uid', 'asesor', 'usuario', 'creadoEn']);
      allow read: if signedIn() && request.auth.uid == advisorUid;
      allow update, delete: if false;
    }
    match /notificacionesPago/{notificationId} {
      allow read, delete: if signedIn() && resource.data.asesorUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.asesorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['nombre', 'cedula', 'fechaNotificacion', 'diaPago', 'asesorUid', 'asesor', 'revisado', 'revisadoEn', 'revisadoPor', 'creadoEn', 'actualizadoEn']);
      allow update: if signedIn() && resource.data.asesorUid == request.auth.uid
        && request.resource.data.asesorUid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
