rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSystemAdmin() {
      return signedIn() && (
        request.auth.uid == 'INJQ1NtkRwRbxfLN2XCwF22flyu2'
        || request.auth.token.email == 'jeblaje@gmail.com'
        || request.auth.token.email == 'jeblaje@intercol-784d9.firebaseapp.com'
      );
    }
    function hasAdministratorRole() {
      let advisorPath = /databases/$(database)/documents/asesores/$(request.auth.uid);
      return signedIn() && exists(advisorPath)
        && get(advisorPath).data.get('rol', 'asesor') == 'administrador';
    }
    function hasAdminPanelPermission(sectionId) {
      let advisorPath = /databases/$(database)/documents/asesores/$(request.auth.uid);
      let roleId = exists(advisorPath) ? get(advisorPath).data.get('rol', 'asesor') : 'asesor';
      let rolePath = /databases/$(database)/documents/rolesAsesores/$(roleId);
      return signedIn() && exists(advisorPath)
        && roleId is string && exists(rolePath)
        && (roleId == 'administrador'
          || (get(rolePath).data.get('permisos', {}) is map
            && get(rolePath).data.permisos.get('panelAdmin', {}) is map
            && get(rolePath).data.permisos.panelAdmin.get('acceder', false) == true
            && get(rolePath).data.permisos.panelAdmin.get(sectionId, false) == true));
    }
    function sectionUsesRoles(sectionId) {
      return !(sectionId in ['mensajes-temporales', 'utilidades', 'reporte-servicio']);
    }
    function advisorRoleAllows(roleId, sectionId, action) {
      let rolePath = /databases/$(database)/documents/rolesAsesores/$(roleId);
      return roleId is string && exists(rolePath)
        && get(rolePath).data.permisos is map
        && get(rolePath).data.permisos[sectionId] is map
        && get(rolePath).data.permisos[sectionId][action] == true;
    }
    function hasSectionPermission(sectionId, action) {
      let advisorPath = /databases/$(database)/documents/asesores/$(request.auth.uid);
      return isSystemAdmin() || (signedIn() && (
        !sectionUsesRoles(sectionId) ||
        (exists(advisorPath) && advisorRoleAllows(get(advisorPath).data.get('rol', 'asesor'), sectionId, action))
      ));
    }
    function isRegisteredAdvisor() {
      let advisorPath = /databases/$(database)/documents/asesores/$(request.auth.uid);
      return signedIn() && exists(advisorPath);
    }
    function hasChatAccess() {
      let advisorPath = /databases/$(database)/documents/asesores/$(request.auth.uid);
      let roleId = exists(advisorPath) ? get(advisorPath).data.get('rol', 'asesor') : 'asesor';
      let rolePath = /databases/$(database)/documents/rolesAsesores/$(roleId);
      let permissions = exists(rolePath) ? get(rolePath).data.get('permisos', {}) : {};
      return isSystemAdmin() || (isRegisteredAdvisor() && (
        (roleId == 'asesor' && (!(permissions is map) || !('chat' in permissions)
          || !(permissions.chat is map) || !('acceder' in permissions.chat)
          || permissions.chat.acceder != false))
        || (permissions is map && permissions.get('chat', {}) is map
          && permissions.get('chat', {}).get('acceder', false) == true)
      ));
    }
    match /smsTemp/{messageId} {
      allow read: if true;
      allow create: if signedIn() && hasSectionPermission('mensajes-temporales', 'crear');
      allow update: if signedIn() && hasSectionPermission('mensajes-temporales', 'editar');
      allow delete: if signedIn() && hasSectionPermission('mensajes-temporales', 'eliminar');
    }
    match /configuracionPublica/{configId} {
      allow read: if (configId == 'equipos' && (!signedIn() || hasSectionPermission('utilidades', 'ver')))
        || (configId == 'zonasReajuste' && isRegisteredAdvisor());
      allow create, update: if configId == 'equipos' && (!signedIn() || hasSectionPermission('utilidades', 'editar'))
        && request.resource.data.keys().hasOnly(['soporte', 'ventas', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['soporte', 'ventas', 'actualizadoEn'])
        && request.resource.data.soporte is map
        && request.resource.data.ventas is map
        && request.resource.data.soporte.keys().hasOnly(['arriba', 'abajo', 'sanJuan', 'riohacha'])
        && request.resource.data.soporte.keys().hasAll(['arriba', 'abajo', 'sanJuan', 'riohacha'])
        && request.resource.data.ventas.keys().hasOnly(['valledupar', 'pueblos'])
        && request.resource.data.ventas.keys().hasAll(['valledupar', 'pueblos'])
        && request.resource.data.soporte.arriba is list
        && request.resource.data.soporte.abajo is list
        && request.resource.data.soporte.sanJuan is list
        && request.resource.data.soporte.riohacha is list
        && request.resource.data.ventas.valledupar is list
        && request.resource.data.ventas.pueblos is list;
      allow create, update: if configId == 'zonasReajuste'
        && (hasAdministratorRole() || isSystemAdmin())
        && request.resource.data.keys().hasOnly(['zonas', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['zonas', 'actualizadoEn'])
        && request.resource.data.zonas is list
        && request.resource.data.zonas.size() <= 200;
      allow delete: if false;
    }
    match /cajasVerificadas/{boxId} {
      allow read: if isRegisteredAdvisor();
      allow create: if signedIn() && hasSectionPermission('verificar-caja', 'crear')
        && (isSystemAdmin() || request.resource.data.asesorUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['fecha', 'tipoCaja', 'numeroCaja', 'direccion', 'barrio', 'zona', 'notasVerificacion', 'cajaOrigenId', 'tecnico', 'asesor', 'link', 'cedulas', 'asesorUid', 'creadoPor', 'usuarioRegistrado', 'creadoEn'])
        && (!('barrio' in request.resource.data) || request.resource.data.barrio is string)
        && (!('zona' in request.resource.data) || request.resource.data.zona is string)
        && (!('notasVerificacion' in request.resource.data) || (request.resource.data.notasVerificacion is string && request.resource.data.notasVerificacion.size() <= 2000))
        && (!('cajaOrigenId' in request.resource.data) || request.resource.data.cajaOrigenId is string);
      allow update: if signedIn() && hasSectionPermission('verificar-caja', 'editar')
        && (isSystemAdmin() || hasAdministratorRole() || resource.data.asesorUid == request.auth.uid);
      allow delete: if signedIn() && hasSectionPermission('verificar-caja', 'eliminar')
        && (isSystemAdmin() || hasAdministratorRole() || resource.data.asesorUid == request.auth.uid);
    }
    function canManageBoxLocation() {
      return signedIn() && (hasSectionPermission('verificar-caja', 'crear') || hasSectionPermission('verificar-caja', 'editar'));
    }
    match /barriosCajas/{locationId} {
      allow read: if isRegisteredAdvisor();
      allow create, update: if canManageBoxLocation()
        && request.resource.data.keys().hasOnly(['nombre', 'nombreNormalizado', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['nombre', 'nombreNormalizado', 'actualizadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.nombreNormalizado is string
        && request.resource.data.nombreNormalizado.size() <= 120;
      allow delete: if false;
    }
    match /zonasCajas/{locationId} {
      allow read: if isRegisteredAdvisor();
      allow create, update: if canManageBoxLocation()
        && request.resource.data.keys().hasOnly(['nombre', 'nombreNormalizado', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['nombre', 'nombreNormalizado', 'actualizadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.nombreNormalizado is string
        && request.resource.data.nombreNormalizado.size() <= 120;
      allow delete: if false;
    }
    match /asesores/{advisorUid} {
      allow create: if signedIn() && request.auth.uid == advisorUid
        && request.resource.data.uid == advisorUid
        && request.resource.data.rol == 'asesor'
        && request.resource.data.keys().hasOnly(['uid', 'asesor', 'usuario', 'rol', 'email', 'correoRecuperacion', 'creadoEn']);
      allow read: if isSystemAdmin() || (signedIn() && request.auth.uid == advisorUid) || hasSectionPermission('roles-permisos', 'ver') || hasAdminPanelPermission('asesores');
      allow update: if (isSystemAdmin()
        && request.resource.data.rol is string
        && exists(/databases/$(database)/documents/rolesAsesores/$(request.resource.data.rol))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol', 'rolActualizadoPor', 'rolActualizadoEn']))
        || (signedIn() && hasAdminPanelPermission('asesores')
          && hasSectionPermission('roles-permisos', 'editar')
          && request.resource.data.rol is string
          && exists(/databases/$(database)/documents/rolesAsesores/$(request.resource.data.rol))
          && request.resource.data.rolActualizadoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol', 'rolActualizadoPor', 'rolActualizadoEn']))
        || (signedIn() && request.auth.uid == advisorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'correoRecuperacion'])
          && request.resource.data.email is string
          && request.resource.data.correoRecuperacion == request.resource.data.email);
      allow delete: if false;
    }
    match /loginAliases/{username} {
      // The login page can resolve a known username, but cannot enumerate usernames.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/asesores/$(request.auth.uid)).data.usuario == username
        && request.resource.data.usuario == username
        && request.resource.data.email is string
        && request.resource.data.keys().hasOnly(['uid', 'usuario', 'email', 'actualizadoEn']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/asesores/$(request.auth.uid)).data.usuario == username
        && request.resource.data.usuario == username
        && request.resource.data.email is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'usuario', 'email', 'actualizadoEn']);
      allow delete: if false;
    }
    match /chatDirectorio/{advisorUid} {
      allow read: if hasChatAccess();
      allow create: if hasChatAccess() && request.auth.uid == advisorUid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'usuario', 'online', 'lastSeenAt', 'typingConversationId', 'typingUntil', 'updatedAt'])
        && request.resource.data.uid == advisorUid
        && request.resource.data.nombre == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('asesor', '')
        && request.resource.data.usuario == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('usuario', '')
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 100
        && request.resource.data.usuario is string && request.resource.data.usuario.size() <= 40
        && request.resource.data.online is bool
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.typingConversationId is string;
      allow create: if (isSystemAdmin() || hasSectionPermission('roles-permisos', 'ver') || hasAdminPanelPermission('asesores'))
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'usuario', 'online', 'lastSeenAt', 'typingConversationId', 'typingUntil', 'updatedAt'])
        && request.resource.data.uid == advisorUid
        && request.resource.data.nombre == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('asesor', '')
        && request.resource.data.usuario == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('usuario', '')
        && request.resource.data.online == false
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.typingConversationId == ''
        && request.resource.data.typingUntil == null;
      allow update: if hasChatAccess() && request.auth.uid == advisorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'usuario', 'online', 'lastSeenAt', 'typingConversationId', 'typingUntil', 'updatedAt'])
        && request.resource.data.uid == advisorUid
        && request.resource.data.nombre == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('asesor', '')
        && request.resource.data.usuario == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('usuario', '')
        && request.resource.data.online is bool
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.typingConversationId is string;
      allow update: if (isSystemAdmin() || hasSectionPermission('roles-permisos', 'ver') || hasAdminPanelPermission('asesores'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'nombre', 'usuario', 'online', 'lastSeenAt', 'typingConversationId', 'typingUntil', 'updatedAt'])
        && request.resource.data.uid == advisorUid
        && request.resource.data.nombre == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('asesor', '')
        && request.resource.data.usuario == get(/databases/$(database)/documents/asesores/$(advisorUid)).data.get('usuario', '')
        && request.resource.data.online == false
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.typingConversationId == ''
        && request.resource.data.typingUntil == null;
      allow delete: if false;
    }
    match /conversacionesChat/{conversationId} {
      allow read: if hasChatAccess() && request.auth.uid in resource.data.participantUids;
      allow create: if hasChatAccess()
        && request.resource.data.keys().hasOnly(['participantUids', 'participantNames', 'updatedAt', 'lastMessageText', 'lastMessageSenderUid', 'lastMessageSenderName', 'lastMessageAt', 'lastReadAtByUid'])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantNames is map
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageSenderUid == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() > 0
        && request.resource.data.lastMessageText.size() <= 4000
        && request.resource.data.lastMessageAt == request.time;
      allow update: if hasChatAccess() && request.auth.uid in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessageText', 'lastMessageSenderUid', 'lastMessageSenderName', 'lastMessageAt', 'participantNames', 'lastReadAtByUid'])
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastReadAtByUid'])
          && request.resource.data.lastReadAtByUid is map
          && request.resource.data.lastReadAtByUid.diff(resource.data.get('lastReadAtByUid', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.lastReadAtByUid.get(request.auth.uid, null) == request.time)
          || (request.resource.data.lastMessageSenderUid == request.auth.uid
            && request.resource.data.lastMessageText is string
            && request.resource.data.lastMessageText.size() > 0
            && request.resource.data.lastMessageText.size() <= 4000
            && request.resource.data.lastMessageAt == request.time));
      allow delete: if false;
      match /mensajes/{messageId} {
        function parentConversation() {
          return getAfter(/databases/$(database)/documents/conversacionesChat/$(conversationId)).data;
        }
        allow read: if hasChatAccess()
          && request.auth.uid in get(/databases/$(database)/documents/conversacionesChat/$(conversationId)).data.participantUids;
        allow create: if hasChatAccess()
          && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'recipientUid', 'text', 'createdAt', 'readAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.recipientUid in parentConversation().participantUids
          && request.auth.uid in parentConversation().participantUids
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && request.resource.data.readAt == null;
        allow update: if hasChatAccess()
          && resource.data.recipientUid == request.auth.uid
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }
    match /rolesAsesores/{roleId} {
      allow read: if signedIn();
      allow create: if (roleId != 'administrador' || isSystemAdmin())
        && hasSectionPermission('roles-permisos', 'crear')
        && request.resource.data.nombre is string
        && request.resource.data.permisos is map
        && request.resource.data.keys().hasOnly(['nombre', 'permisos', 'creadoPor', 'actualizadoPor', 'actualizadoEn']);
      allow update: if (roleId != 'administrador' || isSystemAdmin()
          || (hasAdminPanelPermission('rolesPermisos') && hasSectionPermission('roles-permisos', 'editar')))
        && hasSectionPermission('roles-permisos', 'editar')
        && request.resource.data.nombre is string
        && request.resource.data.permisos is map
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'permisos', 'actualizadoPor', 'actualizadoEn']);
      allow delete: if !(roleId in ['asesor', 'administrador']) && hasSectionPermission('roles-permisos', 'eliminar');
    }
    match /permisosAsesores/{advisorUid} {
      allow read: if isSystemAdmin() || (signedIn() && request.auth.uid == advisorUid);
      allow create, update: if isSystemAdmin()
        && request.resource.data.asesorUid == advisorUid
        && request.resource.data.keys().hasOnly(['asesorUid', 'rol', 'permisos', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['asesorUid', 'rol', 'permisos', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.rol in ['Operador', 'Solo lectura', 'Personalizado']
        && request.resource.data.permisos is map;
      allow delete: if isSystemAdmin();
    }
    match /notificacionesPago/{notificationId} {
      allow read: if isSystemAdmin() || (signedIn() && resource.data.asesorUid == request.auth.uid && hasSectionPermission('notificaciones-pago', 'ver'));
      allow delete: if signedIn() && hasSectionPermission('notificaciones-pago', 'eliminar')
        && (isSystemAdmin() || resource.data.asesorUid == request.auth.uid);
      allow create: if signedIn() && hasSectionPermission('notificaciones-pago', 'crear')
        && (isSystemAdmin() || request.resource.data.asesorUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['nombre', 'cedula', 'fechaNotificacion', 'diaPago', 'processId', 'asesorUid', 'asesor', 'revisado', 'revisadoEn', 'revisadoPor', 'creadoEn', 'actualizadoEn'])
        && (request.resource.data.get('processId', null) == null || request.resource.data.processId is string);
      allow update: if signedIn() && hasSectionPermission('notificaciones-pago', 'editar')
        && (isSystemAdmin() || resource.data.asesorUid == request.auth.uid)
        && (isSystemAdmin() || request.resource.data.asesorUid == request.auth.uid);
    }
    match /retirados/{recordId} {
      allow read: if isSystemAdmin() || (signedIn() && resource.data.asesorUid == request.auth.uid && hasSectionPermission('retirados', 'ver'));
      allow create: if signedIn() && (isSystemAdmin() || (hasSectionPermission('retirados', 'crear') && request.resource.data.asesorUid == request.auth.uid));
      allow update: if signedIn() && (isSystemAdmin() || (resource.data.asesorUid == request.auth.uid && hasSectionPermission('retirados', 'editar') && request.resource.data.asesorUid == request.auth.uid));
      allow delete: if signedIn() && (isSystemAdmin() || (resource.data.asesorUid == request.auth.uid && hasSectionPermission('retirados', 'eliminar')));
    }
    match /retirosTv/{recordId} {
      allow read: if isSystemAdmin() || (signedIn() && resource.data.asesorCreadorUid == request.auth.uid && hasSectionPermission('retiros-tv', 'ver'));
      allow create: if signedIn() && (isSystemAdmin() || (hasSectionPermission('retiros-tv', 'crear') && request.resource.data.asesorCreadorUid == request.auth.uid));
      allow update: if signedIn() && (isSystemAdmin() || (resource.data.asesorCreadorUid == request.auth.uid && hasSectionPermission('retiros-tv', 'editar') && request.resource.data.asesorCreadorUid == request.auth.uid));
      allow delete: if signedIn() && (isSystemAdmin() || (resource.data.asesorCreadorUid == request.auth.uid && hasSectionPermission('retiros-tv', 'eliminar')));
    }
    match /clientes/{clientId} {
      allow read: if isRegisteredAdvisor();
      allow create: if isRegisteredAdvisor()
        && request.resource.data.keys().hasOnly(['nombre', 'cedula', 'cedulaNormalizada', 'estadoCliente', 'plan', 'valorMensual', 'valorReconexion', 'diaPago', 'diaCorte', 'fechaPago', 'fechaCorte', 'fechaGeneracionFactura', 'zona', 'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['nombre', 'cedula', 'cedulaNormalizada', 'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.cedula is string
        && request.resource.data.cedulaNormalizada is string
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.get('estadoCliente', 'sin_registrar') in ['sin_registrar', 'activo', 'suspendido', 'retirado', 'cancelado']
        && (request.resource.data.get('plan', null) == null || request.resource.data.plan is string)
        && (request.resource.data.get('valorMensual', null) == null || (request.resource.data.valorMensual is number && request.resource.data.valorMensual >= 0))
        && (request.resource.data.get('valorReconexion', null) == null || request.resource.data.valorReconexion in [15000, 20000])
        && (request.resource.data.get('diaPago', null) == null || (request.resource.data.diaPago is int && request.resource.data.diaPago >= 1 && request.resource.data.diaPago <= 31))
        && (request.resource.data.get('diaCorte', null) == null || (request.resource.data.diaCorte is int && request.resource.data.diaCorte >= 1 && request.resource.data.diaCorte <= 31))
        && (request.resource.data.get('zona', null) == null || request.resource.data.zona is string)
        && (request.resource.data.get('fechaPago', null) == null || request.resource.data.fechaPago is string)
        && (request.resource.data.get('fechaCorte', null) == null || request.resource.data.fechaCorte is string)
        && (request.resource.data.get('fechaGeneracionFactura', null) == null || request.resource.data.fechaGeneracionFactura is string);
      allow update: if isRegisteredAdvisor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoCliente', 'plan', 'valorMensual', 'valorReconexion', 'diaPago', 'diaCorte', 'fechaPago', 'fechaCorte', 'fechaGeneracionFactura', 'zona', 'actualizadoEn'])
        && request.resource.data.get('estadoCliente', resource.data.get('estadoCliente', 'sin_registrar')) in ['sin_registrar', 'activo', 'suspendido', 'retirado', 'cancelado']
        && (request.resource.data.get('plan', null) == null || request.resource.data.plan is string)
        && (request.resource.data.get('valorMensual', null) == null || (request.resource.data.valorMensual is number && request.resource.data.valorMensual >= 0))
        && (request.resource.data.get('valorReconexion', null) == null || request.resource.data.valorReconexion in [15000, 20000])
        && (request.resource.data.get('diaPago', null) == null || (request.resource.data.diaPago is int && request.resource.data.diaPago >= 1 && request.resource.data.diaPago <= 31))
        && (request.resource.data.get('diaCorte', null) == null || (request.resource.data.diaCorte is int && request.resource.data.diaCorte >= 1 && request.resource.data.diaCorte <= 31))
        && (request.resource.data.get('zona', null) == null || request.resource.data.zona is string)
        && (request.resource.data.get('fechaPago', null) == null || request.resource.data.fechaPago is string)
        && (request.resource.data.get('fechaCorte', null) == null || request.resource.data.fechaCorte is string)
        && (request.resource.data.get('fechaGeneracionFactura', null) == null || request.resource.data.fechaGeneracionFactura is string);
      allow delete: if false;
    }
    match /procesosClientes/{processId} {
      allow read: if isRegisteredAdvisor()
        && (resource.data.tipo != 'abono' || resource.data.estado == 'completado' || resource.data.iniciadoPorUid == request.auth.uid);
      allow create: if isRegisteredAdvisor()
        && request.resource.data.keys().hasOnly(['clienteId', 'clienteNombre', 'clienteCedula', 'tipo', 'estado', 'informacion', 'pasos', 'pasosVerificados', 'iniciadoPorUid', 'iniciadoPorNombre', 'iniciadoEn', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['clienteId', 'clienteNombre', 'clienteCedula', 'tipo', 'estado', 'informacion', 'pasos', 'pasosVerificados', 'iniciadoPorUid', 'iniciadoPorNombre', 'iniciadoEn', 'actualizadoEn'])
        && request.resource.data.tipo in ['reconexion', 'abono', 'cambio-fecha-pago', 'cambio-plan']
        && request.resource.data.estado == 'en_curso'
        && request.resource.data.informacion is map
        && request.resource.data.pasos is list
        && request.resource.data.pasosVerificados is list
        && request.resource.data.iniciadoPorUid == request.auth.uid
        && exists(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId));
      allow update: if isRegisteredAdvisor()
        && resource.data.iniciadoPorUid == request.auth.uid
        && request.resource.data.iniciadoPorUid == resource.data.iniciadoPorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['informacion', 'pasos', 'pasosVerificados', 'estado', 'actualizadoEn', 'completadoEn'])
        && request.resource.data.informacion is map
        && request.resource.data.pasos is list
        && request.resource.data.pasosVerificados is list
        && request.resource.data.estado in ['en_curso', 'completado'];
      allow delete: if isRegisteredAdvisor()
        && (resource.data.iniciadoPorUid == request.auth.uid || hasAdministratorRole() || isSystemAdmin());
    }
    match /{document=**} { allow read, write: if false; }
  }
}
