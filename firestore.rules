rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIsAdministrator(roleId) {
      let rolePath = /databases/$(database)/documents/rolesAsesores/$(roleId);
      return roleId is string
        && (roleId == 'administrador'
          || (exists(rolePath) && get(rolePath).data.get('nombre', '') == 'Administrador'));
    }
    function hasAdministratorRole() {
      let advisorPath = /databases/$(database)/documents/asesores/$(request.auth.uid);
      return signedIn() && exists(advisorPath)
        && roleIsAdministrator(get(advisorPath).data.get('rol', ''));
    }
    function isSystemAdmin() {
      return signedIn() && (
        request.auth.uid == 'INJQ1NtkRwRbxfLN2XCwF22flyu2'
        || request.auth.token.email == 'jeblaje@intercol-784d9.firebaseapp.com'
        || hasAdministratorRole()
      );
    }
    function sectionUsesRoles(sectionId) {
      return !(sectionId in ['mensajes-temporales', 'utilidades', 'cajas-verificadas', 'reporte-servicio']);
    }
    function advisorRoleAllows(roleId, sectionId, action) {
      let rolePath = /databases/$(database)/documents/rolesAsesores/$(roleId);
      return roleId is string && exists(rolePath)
        && get(rolePath).data.permisos is map
        && get(rolePath).data.permisos[sectionId] is map
        && get(rolePath).data.permisos[sectionId][action] == true;
    }
    function hasSectionPermission(sectionId, action) {
      let advisorPath = /databases/$(database)/documents/asesores/$(request.auth.uid);
      return isSystemAdmin() || (signedIn() && (
        !sectionUsesRoles(sectionId) ||
        (exists(advisorPath) && advisorRoleAllows(get(advisorPath).data.get('rol', 'asesor'), sectionId, action))
      ));
    }
    match /smsTemp/{messageId} {
      allow read: if true;
      allow create: if signedIn() && hasSectionPermission('mensajes-temporales', 'crear');
      allow update: if signedIn() && hasSectionPermission('mensajes-temporales', 'editar');
      allow delete: if signedIn() && hasSectionPermission('mensajes-temporales', 'eliminar');
    }
    match /configuracionPublica/{configId} {
      allow read: if configId == 'equipos' && (!signedIn() || hasSectionPermission('utilidades', 'ver'));
      allow create, update: if configId == 'equipos' && (!signedIn() || hasSectionPermission('utilidades', 'editar'))
        && request.resource.data.keys().hasOnly(['soporte', 'ventas', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['soporte', 'ventas', 'actualizadoEn'])
        && request.resource.data.soporte is map
        && request.resource.data.ventas is map
        && request.resource.data.soporte.keys().hasOnly(['arriba', 'abajo', 'sanJuan', 'riohacha'])
        && request.resource.data.soporte.keys().hasAll(['arriba', 'abajo', 'sanJuan', 'riohacha'])
        && request.resource.data.ventas.keys().hasOnly(['valledupar', 'pueblos'])
        && request.resource.data.ventas.keys().hasAll(['valledupar', 'pueblos'])
        && request.resource.data.soporte.arriba is list
        && request.resource.data.soporte.abajo is list
        && request.resource.data.soporte.sanJuan is list
        && request.resource.data.soporte.riohacha is list
        && request.resource.data.ventas.valledupar is list
        && request.resource.data.ventas.pueblos is list;
      allow delete: if false;
    }
    match /cajasVerificadas/{boxId} {
      allow read: if true;
      allow create: if signedIn() && hasSectionPermission('verificar-caja', 'crear')
        && (isSystemAdmin() || request.resource.data.asesorUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['fecha', 'tipoCaja', 'numeroCaja', 'direccion', 'tecnico', 'asesor', 'link', 'cedulas', 'asesorUid', 'creadoPor', 'usuarioRegistrado', 'creadoEn']);
      allow update: if signedIn() && hasSectionPermission('cajas-verificadas', 'editar')
        && (isSystemAdmin() || resource.data.asesorUid == request.auth.uid);
      allow delete: if signedIn() && hasSectionPermission('cajas-verificadas', 'eliminar')
        && (isSystemAdmin() || resource.data.asesorUid == request.auth.uid);
    }
    match /asesores/{advisorUid} {
      allow create: if signedIn() && request.auth.uid == advisorUid
        && request.resource.data.uid == advisorUid
        && request.resource.data.rol == 'asesor'
        && request.resource.data.keys().hasOnly(['uid', 'asesor', 'usuario', 'rol', 'email', 'correoRecuperacion', 'creadoEn']);
      allow read: if isSystemAdmin() || (signedIn() && request.auth.uid == advisorUid) || hasSectionPermission('roles-permisos', 'ver');
      allow update: if (isSystemAdmin()
        && request.resource.data.rol is string
        && exists(/databases/$(database)/documents/rolesAsesores/$(request.resource.data.rol))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol', 'rolActualizadoPor', 'rolActualizadoEn']))
        || (signedIn() && request.auth.uid == advisorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'correoRecuperacion'])
          && request.resource.data.email is string
          && request.resource.data.correoRecuperacion == request.resource.data.email);
      allow delete: if false;
    }
    match /loginAliases/{username} {
      // The login page can resolve a known username, but cannot enumerate usernames.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/asesores/$(request.auth.uid)).data.usuario == username
        && request.resource.data.usuario == username
        && request.resource.data.email is string
        && request.resource.data.keys().hasOnly(['uid', 'usuario', 'email', 'actualizadoEn']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/asesores/$(request.auth.uid)).data.usuario == username
        && request.resource.data.usuario == username
        && request.resource.data.email is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'usuario', 'email', 'actualizadoEn']);
      allow delete: if false;
    }
    match /rolesAsesores/{roleId} {
      allow read: if signedIn();
      allow create: if (roleId != 'administrador' || isSystemAdmin())
        && hasSectionPermission('roles-permisos', 'crear')
        && request.resource.data.nombre is string
        && request.resource.data.permisos is map
        && request.resource.data.keys().hasOnly(['nombre', 'permisos', 'creadoPor', 'actualizadoPor', 'actualizadoEn']);
      allow update: if (roleId != 'administrador' || isSystemAdmin())
        && hasSectionPermission('roles-permisos', 'editar')
        && request.resource.data.nombre is string
        && request.resource.data.permisos is map
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'permisos', 'actualizadoPor', 'actualizadoEn']);
      allow delete: if !(roleId in ['asesor', 'administrador']) && hasSectionPermission('roles-permisos', 'eliminar');
    }
    match /permisosAsesores/{advisorUid} {
      allow read: if isSystemAdmin() || (signedIn() && request.auth.uid == advisorUid);
      allow create, update: if isSystemAdmin()
        && request.resource.data.asesorUid == advisorUid
        && request.resource.data.keys().hasOnly(['asesorUid', 'rol', 'permisos', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['asesorUid', 'rol', 'permisos', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.rol in ['Operador', 'Solo lectura', 'Personalizado']
        && request.resource.data.permisos is map;
      allow delete: if isSystemAdmin();
    }
    match /notificacionesPago/{notificationId} {
      allow read: if isSystemAdmin() || (signedIn() && resource.data.asesorUid == request.auth.uid && hasSectionPermission('notificaciones-pago', 'ver'));
      allow delete: if signedIn() && hasSectionPermission('notificaciones-pago', 'eliminar')
        && (isSystemAdmin() || resource.data.asesorUid == request.auth.uid);
      allow create: if signedIn() && hasSectionPermission('notificaciones-pago', 'crear')
        && (isSystemAdmin() || request.resource.data.asesorUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['nombre', 'cedula', 'fechaNotificacion', 'diaPago', 'asesorUid', 'asesor', 'revisado', 'revisadoEn', 'revisadoPor', 'creadoEn', 'actualizadoEn']);
      allow update: if signedIn() && hasSectionPermission('notificaciones-pago', 'editar')
        && (isSystemAdmin() || resource.data.asesorUid == request.auth.uid)
        && (isSystemAdmin() || request.resource.data.asesorUid == request.auth.uid);
    }
    match /retirados/{recordId} {
      allow read: if isSystemAdmin() || (signedIn() && resource.data.asesorUid == request.auth.uid && hasSectionPermission('retirados', 'ver'));
      allow create: if signedIn() && (isSystemAdmin() || (hasSectionPermission('retirados', 'crear') && request.resource.data.asesorUid == request.auth.uid));
      allow update: if signedIn() && (isSystemAdmin() || (resource.data.asesorUid == request.auth.uid && hasSectionPermission('retirados', 'editar') && request.resource.data.asesorUid == request.auth.uid));
      allow delete: if signedIn() && (isSystemAdmin() || (resource.data.asesorUid == request.auth.uid && hasSectionPermission('retirados', 'eliminar')));
    }
    match /retirosTv/{recordId} {
      allow read: if isSystemAdmin() || (signedIn() && resource.data.asesorCreadorUid == request.auth.uid && hasSectionPermission('retiros-tv', 'ver'));
      allow create: if signedIn() && (isSystemAdmin() || (hasSectionPermission('retiros-tv', 'crear') && request.resource.data.asesorCreadorUid == request.auth.uid));
      allow update: if signedIn() && (isSystemAdmin() || (resource.data.asesorCreadorUid == request.auth.uid && hasSectionPermission('retiros-tv', 'editar') && request.resource.data.asesorCreadorUid == request.auth.uid));
      allow delete: if signedIn() && (isSystemAdmin() || (resource.data.asesorCreadorUid == request.auth.uid && hasSectionPermission('retiros-tv', 'eliminar')));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
